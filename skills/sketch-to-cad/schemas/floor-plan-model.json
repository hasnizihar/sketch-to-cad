{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ResidentialFloorPlanModel",
  "description": "Structured intermediate coordinate-based representation of a residential floor plan bridging sketch interpretation, user approval, and CADCraft drafting.",
  "type": "object",
  "required": ["metadata", "status", "units", "envelope", "walls", "openings", "rooms", "dimensions", "uncertainties"],
  "properties": {
    "metadata": {
      "type": "object",
      "required": ["projectName", "version", "createdAt"],
      "properties": {
        "projectName": { "type": "string" },
        "author": { "type": "string" },
        "version": { "type": "string" },
        "createdAt": { "type": "string" }
      }
    },
    "status": {
      "type": "string",
      "enum": ["draft", "awaiting_approval", "approved", "rejected"],
      "description": "Approval state. Generation must not proceed unless status is approved."
    },
    "approval": {
      "type": "object",
      "properties": {
        "approvedBy": { "type": "string" },
        "approvedAt": { "type": "string" },
        "approvalNotes": { "type": "string" },
        "floorApprovals": {
          "type": "object",
          "description": "Per-floor approval states for multi-storey projects.",
          "additionalProperties": {
            "type": "string",
            "enum": ["draft", "awaiting_approval", "approved", "rejected"]
          }
        }
      }
    },
    "floorId": {
      "type": "string",
      "description": "Default floor level identifier for single-storey models."
    },
    "floors": {
      "type": "array",
      "description": "Coordinated sequence of floors/levels for multi-storey residential projects.",
      "items": {
        "type": "object",
        "required": ["id", "name"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "sequence": { "type": "integer" },
          "elevationMm": { "type": ["number", "null"] },
          "heightMm": { "type": ["number", "null"] },
          "status": {
            "type": "string",
            "enum": ["draft", "awaiting_approval", "approved", "rejected"]
          },
          "envelope": {
            "type": "object",
            "properties": {
              "width": { "type": "number", "minimum": 0 },
              "depth": { "type": "number", "minimum": 0 },
              "origin": {
                "type": "array",
                "items": { "type": "number" },
                "minItems": 2,
                "maxItems": 2
              }
            }
          }
        }
      }
    },
    "stairs": {
      "type": "array",
      "description": "Staircases and vertical circulation connecting project levels.",
      "items": {
        "type": "object",
        "required": ["id", "sourceFloorId", "destinationFloorId", "footprint"],
        "properties": {
          "id": { "type": "string" },
          "sourceFloorId": { "type": "string" },
          "destinationFloorId": { "type": "string" },
          "footprint": {
            "type": "array",
            "items": {
              "type": "array",
              "items": { "type": "number" },
              "minItems": 2,
              "maxItems": 2
            },
            "minItems": 3
          },
          "flightWidth": { "type": "number", "minimum": 0 },
          "directionOfTravel": { "type": "string" },
          "relatedOpeningId": { "type": "string" },
          "alignmentToleranceMm": { "type": "number", "default": 50.0 },
          "status": { "type": "string" }
        }
      }
    },
    "units": {
      "type": "string",
      "enum": ["mm", "m", "in", "ft"],
      "description": "Drawing units used for all coordinate and dimension values."
    },
    "envelope": {
      "type": "object",
      "required": ["width", "depth", "origin", "widthSource", "depthSource"],
      "properties": {
        "width": { "type": "number", "minimum": 0 },
        "depth": { "type": "number", "minimum": 0 },
        "origin": {
          "type": "array",
          "items": { "type": "number" },
          "minItems": 2,
          "maxItems": 2
        },
        "widthSource": { "type": "string", "enum": ["explicit", "estimated", "inferred"] },
        "depthSource": { "type": "string", "enum": ["explicit", "estimated", "inferred"] }
      }
    },
    "uncertainties": {
      "type": "array",
      "description": "Explicit log of all ambiguous or estimated features requiring user review.",
      "items": {
        "type": "object",
        "required": ["id", "target", "description", "status"],
        "properties": {
          "id": { "type": "string" },
          "target": { "type": "string" },
          "description": { "type": "string" },
          "assumedValue": { "type": ["string", "number", "null"] },
          "confidence": { "type": "string", "enum": ["low", "medium", "high"] },
          "status": { "type": "string", "enum": ["unresolved", "confirmed", "corrected"] }
        }
      }
    },
    "walls": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "start", "end", "thickness", "layer", "source"],
        "properties": {
          "id": { "type": "string" },
          "type": { "type": "string", "enum": ["exterior", "interior"] },
          "start": {
            "type": "array",
            "items": { "type": "number" },
            "minItems": 2,
            "maxItems": 2
          },
          "end": {
            "type": "array",
            "items": { "type": "number" },
            "minItems": 2,
            "maxItems": 2
          },
          "thickness": { "type": "number", "minimum": 0 },
          "layer": { "type": "string" },
          "source": { "type": "string", "enum": ["explicit", "estimated", "inferred"] },
          "openingIds": {
            "type": "array",
            "items": { "type": "string" }
          },
          "floorId": { "type": "string" }
        }
      }
    },
    "openings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "wallId", "center", "width", "source"],
        "properties": {
          "id": { "type": "string" },
          "type": { "type": "string", "enum": ["door", "window", "cased_opening"] },
          "wallId": { "type": "string" },
          "floorId": { "type": "string" },
          "center": {
            "type": "array",
            "items": { "type": "number" },
            "minItems": 2,
            "maxItems": 2
          },
          "width": { "type": "number", "minimum": 0 },
          "sillHeight": { "type": "number" },
          "swing": {
            "type": "string",
            "enum": ["inward-left", "inward-right", "outward-left", "outward-right", "double", "sliding", "none"]
          },
          "source": { "type": "string", "enum": ["explicit", "estimated", "inferred"] }
        }
      }
    },
    "rooms": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "labelPosition", "approximateArea"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "floorId": { "type": "string" },
          "approximateArea": { "type": "number", "minimum": 0 },
          "labelPosition": {
            "type": "array",
            "items": { "type": "number" },
            "minItems": 2,
            "maxItems": 2
          },
          "boundaryCorners": {
            "type": "array",
            "items": {
              "type": "array",
              "items": { "type": "number" },
              "minItems": 2,
              "maxItems": 2
            }
          }
        }
      }
    },
    "dimensions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "p1", "p2", "at", "source"],
        "properties": {
          "id": { "type": "string" },
          "floorId": { "type": "string" },
          "tier": { "type": "integer", "enum": [1, 2, 3] },
          "p1": {
            "type": "array",
            "items": { "type": "number" },
            "minItems": 2,
            "maxItems": 2
          },
          "p2": {
            "type": "array",
            "items": { "type": "number" },
            "minItems": 2,
            "maxItems": 2
          },
          "at": {
            "type": "array",
            "items": { "type": "number" },
            "minItems": 2,
            "maxItems": 2
          },
          "source": { "type": "string", "enum": ["explicit", "estimated", "inferred"] },
          "text": { "type": "string" }
        }
      }
    },
    "elements": {
      "type": "array",
      "description": "Optional collection of architectural building elements, furniture, and fixtures.",
      "items": {
        "type": "object",
        "required": ["id", "blockId", "category", "position", "source"],
        "properties": {
          "id": { "type": "string" },
          "blockId": { "type": "string" },
          "category": { "type": "string", "enum": ["furniture", "sanitary", "kitchen", "circulation", "structural"] },
          "position": {
            "type": "array",
            "items": { "type": "number" },
            "minItems": 2,
            "maxItems": 2
          },
          "rotation": { "type": "number", "default": 0.0 },
          "scale": {
            "oneOf": [
              { "type": "number", "minimum": 0 },
              {
                "type": "array",
                "items": { "type": "number", "minimum": 0 },
                "minItems": 2,
                "maxItems": 2
              }
            ]
          },
          "dimensions": {
            "type": "object",
            "properties": {
              "width": { "type": "number", "minimum": 0 },
              "depth": { "type": "number", "minimum": 0 }
            }
          },
          "roomId": { "type": "string" },
          "levelId": { "type": "string" },
          "floorId": { "type": "string" },
          "source": { "type": "string", "enum": ["explicit", "estimated", "inferred", "proposed"] },
          "status": { "type": "string", "enum": ["unresolved", "approved", "confirmed", "rejected"] }
        }
      }
    },
    "finishes": {
      "type": "array",
      "description": "Optional collection of floor finishes and tile patterns.",
      "items": {
        "type": "object",
        "required": ["id", "roomId", "pattern", "boundary"],
        "properties": {
          "id": { "type": "string" },
          "roomId": { "type": "string" },
          "floorId": { "type": "string" },
          "pattern": { "type": "string", "enum": ["tile_grid", "wood_strip", "diagonal", "hatch_custom"] },
          "tileSize": { "type": "number", "minimum": 0 },
          "boundary": {
            "type": "array",
            "items": {
              "type": "array",
              "items": { "type": "number" },
              "minItems": 2,
              "maxItems": 2
            },
            "minItems": 2
          },
          "source": { "type": "string", "enum": ["explicit", "estimated", "inferred", "proposed"] }
        }
      }
    }
  }
}
