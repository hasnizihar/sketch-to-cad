{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "BIMHandoffContract",
  "description": "Companion structured metadata specification for architectural floor plans generated by Sketch-to-CAD, consumed by downstream 3D BIM skills (dxf-to-3d-bim).",
  "type": "object",
  "required": [
    "schemaVersion",
    "project",
    "dxf",
    "floors",
    "walls",
    "openings",
    "rooms",
    "elements",
    "finishes",
    "uncertainties",
    "validation"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0",
      "description": "Semantic version of the handoff contract schema."
    },
    "project": {
      "type": "object",
      "required": ["projectName", "drawingId", "units", "coordinateSystem", "createdAt"],
      "properties": {
        "projectName": { "type": "string" },
        "drawingId": { "type": "string" },
        "units": { "type": "string", "enum": ["mm", "m", "in", "ft"] },
        "coordinateSystem": {
          "type": "string",
          "enum": ["Cartesian2D_RightHanded_YUp", "Cartesian2D_Standard"],
          "default": "Cartesian2D_RightHanded_YUp"
        },
        "sourceSketch": { "type": "string" },
        "author": { "type": "string" },
        "createdAt": { "type": "string" }
      }
    },
    "dxf": {
      "type": "object",
      "required": ["filename", "units", "layers", "blocks", "entityCount", "extents"],
      "properties": {
        "filename": { "type": "string" },
        "units": { "type": "string" },
        "layers": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "category"],
            "properties": {
              "name": { "type": "string" },
              "color": { "type": "string" },
              "category": { "type": "string" },
              "entityCount": { "type": "integer" }
            }
          }
        },
        "blocks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "category"],
            "properties": {
              "name": { "type": "string" },
              "category": { "type": "string" },
              "instanceCount": { "type": "integer" }
            }
          }
        },
        "entityCount": { "type": "integer", "minimum": 0 },
        "extents": {
          "type": "array",
          "items": {
            "type": "array",
            "items": { "type": "number" },
            "minItems": 2,
            "maxItems": 2
          },
          "minItems": 2,
          "maxItems": 2
        }
      }
    },
    "floors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "envelope"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "elevation": {
            "type": ["number", "null"],
            "description": "Floor datum elevation in drawing units. Null if unverified in 2D."
          },
          "height": {
            "type": ["number", "null"],
            "description": "Clear storey height if explicitly known. Null if unverified."
          },
          "envelope": {
            "type": "object",
            "required": ["width", "depth", "origin"],
            "properties": {
              "width": { "type": "number", "minimum": 0 },
              "depth": { "type": "number", "minimum": 0 },
              "origin": {
                "type": "array",
                "items": { "type": "number" },
                "minItems": 2,
                "maxItems": 2
              }
            }
          }
        }
      }
    },
    "walls": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "classification", "start", "end", "thickness", "layer", "floorId"],
        "properties": {
          "id": { "type": "string" },
          "classification": { "type": "string", "enum": ["exterior", "interior"] },
          "start": {
            "type": "array",
            "items": { "type": "number" },
            "minItems": 2,
            "maxItems": 2
          },
          "end": {
            "type": "array",
            "items": { "type": "number" },
            "minItems": 2,
            "maxItems": 2
          },
          "thickness": { "type": "number", "minimum": 0 },
          "layer": { "type": "string" },
          "floorId": { "type": "string" },
          "openingIds": {
            "type": "array",
            "items": { "type": "string" }
          },
          "source": { "type": "string", "enum": ["explicit", "estimated", "inferred"] }
        }
      }
    },
    "openings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "wallId", "center", "width", "floorId"],
        "properties": {
          "id": { "type": "string" },
          "type": { "type": "string", "enum": ["door", "window", "cased_opening"] },
          "wallId": { "type": "string" },
          "center": {
            "type": "array",
            "items": { "type": "number" },
            "minItems": 2,
            "maxItems": 2
          },
          "width": { "type": "number", "minimum": 0 },
          "height": { "type": ["number", "null"] },
          "sillHeight": { "type": ["number", "null"] },
          "swing": { "type": "string" },
          "floorId": { "type": "string" },
          "source": { "type": "string", "enum": ["explicit", "estimated", "inferred"] }
        }
      }
    },
    "rooms": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "floorId", "approximateArea", "labelPosition"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "floorId": { "type": "string" },
          "approximateArea": { "type": "number", "minimum": 0 },
          "areaMethod": { "type": "string", "enum": ["polygon_shoelace", "enclosed_bounding_box", "sketch_annotated", "estimated"] },
          "labelPosition": {
            "type": "array",
            "items": { "type": "number" },
            "minItems": 2,
            "maxItems": 2
          },
          "boundaryCorners": {
            "type": "array",
            "items": {
              "type": "array",
              "items": { "type": "number" },
              "minItems": 2,
              "maxItems": 2
            }
          }
        }
      }
    },
    "elements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "blockId", "category", "position", "floorId"],
        "properties": {
          "id": { "type": "string" },
          "blockId": { "type": "string" },
          "category": { "type": "string", "enum": ["furniture", "sanitary", "kitchen", "circulation", "structural"] },
          "position": {
            "type": "array",
            "items": { "type": "number" },
            "minItems": 2,
            "maxItems": 2
          },
          "rotation": { "type": "number" },
          "scale": {
            "oneOf": [
              { "type": "number" },
              {
                "type": "array",
                "items": { "type": "number" },
                "minItems": 2,
                "maxItems": 2
              }
            ]
          },
          "dimensions": {
            "type": "object",
            "properties": {
              "width": { "type": "number" },
              "depth": { "type": "number" }
            }
          },
          "floorId": { "type": "string" },
          "roomId": { "type": "string" },
          "layer": { "type": "string" },
          "source": { "type": "string", "enum": ["explicit", "estimated", "inferred", "proposed"] },
          "status": { "type": "string", "enum": ["unresolved", "approved", "confirmed", "rejected"] }
        }
      }
    },
    "finishes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "roomId", "floorId", "pattern", "boundary"],
        "properties": {
          "id": { "type": "string" },
          "roomId": { "type": "string" },
          "floorId": { "type": "string" },
          "pattern": { "type": "string" },
          "tileSize": { "type": "number" },
          "boundary": {
            "type": "array",
            "items": {
              "type": "array",
              "items": { "type": "number" },
              "minItems": 2,
              "maxItems": 2
            },
            "minItems": 2
          },
          "source": { "type": "string", "enum": ["explicit", "estimated", "inferred", "proposed"] }
        }
      }
    },
    "uncertainties": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "target", "description", "status"],
        "properties": {
          "id": { "type": "string" },
          "target": { "type": "string" },
          "description": { "type": "string" },
          "assumedValue": {},
          "confidence": { "type": "string", "enum": ["low", "medium", "high"] },
          "status": { "type": "string", "enum": ["unresolved", "confirmed", "corrected", "approved"] }
        }
      }
    },
    "validation": {
      "type": "object",
      "required": ["status", "isApproved", "entityIntegrity", "geometryChecks"],
      "properties": {
        "status": { "type": "string", "enum": ["PASSED", "WARNING", "FAILED"] },
        "isApproved": { "type": "boolean" },
        "approvedBy": { "type": "string" },
        "approvedAt": { "type": "string" },
        "entityIntegrity": {
          "type": "object",
          "required": ["entityCount", "layer0Empty"],
          "properties": {
            "entityCount": { "type": "integer" },
            "blockReferences": { "type": "integer" },
            "hatches": { "type": "integer" },
            "layer0Empty": { "type": "boolean" }
          }
        },
        "geometryChecks": {
          "type": "object",
          "required": ["envelopeMatch", "cleanWallJambs"],
          "properties": {
            "envelopeMatch": { "type": "boolean" },
            "cleanWallJambs": { "type": "boolean" },
            "warnings": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
